digraph G {graph [fontname="Times New Roman", fontsize=12, rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", splines=false]; node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F3A4A", fillcolor="#F5F7FA", penwidth=1.2, margin="0.12,0.08"]; edge [fontname="Times New Roman", fontsize=10, color="#4B5563", arrowsize=0.7]; graph [rankdir=LR]; investigations [shape=record,label="{investigations|id UUID PK|user_id nullable|name|description|status|tags|created_at|updated_at}"] ; results [shape=record,label="{investigation_results|id UUID PK|investigation_id UUID FK|tool_name|target|result_data JSONB|ai_analysis|threat_level|created_at|updated_at}"] ; chat [shape=record,label="{chat_history|id UUID PK|user_id|session_id|investigation_id nullable|user_message|bot_response|created_at}"] ; investigations->results [label="1 to many",arrowhead=crow]; investigations->chat [label="optional context",arrowhead=crow,style=dashed];}