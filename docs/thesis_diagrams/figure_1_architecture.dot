digraph G {graph [fontname="Times New Roman", fontsize=12, rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", splines=false]; node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F3A4A", fillcolor="#F5F7FA", penwidth=1.2, margin="0.12,0.08"]; edge [fontname="Times New Roman", fontsize=10, color="#4B5563", arrowsize=0.7]; subgraph cluster_client {label="Presentation Layer"; color="#CBD5E1"; home [label="Home / Guide Assistant\n(home.html, home_assistant.js)"]; tools [label="OSINT Tool Workspace\n(index.html, script.js)"]; dash [label="Investigation Dashboard\n(dashboard.html, dashboard.js, D3.js)"]; opsec [label="OPSEC Learning Page\n(opsec.html, opsec.js)"];} subgraph cluster_flask {label="Flask Application Layer"; color="#CBD5E1"; routes [label="app.py routes\nTool APIs, dashboard APIs, export APIs"]; ai [label="/ai Blueprint\nroutes/ai_routes.py"];} subgraph cluster_services {label="Service Layer"; color="#CBD5E1"; inv [label="InvestigationService\nCRUD and result retrieval"]; res [label="ResultsService\nAuto-save and threat heuristics"]; netgraph [label="NetworkGraphService\nEntity extraction and graph JSON"]; interp [label="ResultInterpretationService\nPlain-language result explanations"]; genai [label="GeminiAIService\nPrimary LLM"]; mistral [label="MistralAIService\nFallback LLM"]; guide [label="MistralGuideService\nHomepage guidance"];} subgraph cluster_data {label="Data and External Services"; color="#CBD5E1"; supa [shape=cylinder, label="Supabase PostgreSQL\ninvestigations, results, chat_history"]; apis [label="External OSINT APIs\nVirusTotal, AbuseIPDB, HIBP, Shodan,\nMAC vendors, ip-api, Wayback, blockchain"];} home->routes; tools->routes; dash->routes; dash->ai; home->ai; opsec->routes; routes->inv; routes->res; routes->netgraph; routes->interp; ai->genai; ai->mistral; ai->inv; ai->guide; inv->supa; res->inv; netgraph->inv; interp->genai; routes->apis; genai->apis [label="AI provider API"]; mistral->apis [label="AI provider API"];}