digraph G {graph [fontname="Times New Roman", fontsize=12, rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", splines=false]; node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F3A4A", fillcolor="#F5F7FA", penwidth=1.2, margin="0.12,0.08"]; edge [fontname="Times New Roman", fontsize=10, color="#4B5563", arrowsize=0.7]; graph [rankdir=LR]; actor [shape=ellipse,fillcolor="#E0F2FE",label="Investigator / Student"]; subgraph cluster_system {label="Easint System Boundary"; color="#94A3B8"; create [shape=ellipse,label="Create investigation"]; run [shape=ellipse,label="Run OSINT tool"]; save [shape=ellipse,label="Auto-save result"]; view [shape=ellipse,label="Review dashboard"]; netgraph [shape=ellipse,label="Generate network graph"]; chat [shape=ellipse,label="Ask AI questions"]; analyze [shape=ellipse,label="Generate AI summary"]; export [shape=ellipse,label="Export report/data"]; learn [shape=ellipse,label="Study OPSEC guidance"];} actor->create; actor->run; actor->view; actor->netgraph; actor->chat; actor->analyze; actor->export; actor->learn; run->save [style=dashed,label="includes"]; analyze->save [style=dashed,label="persists summary"];}